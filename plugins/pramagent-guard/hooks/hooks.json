{
  "description": "Pramagent Guard: deterministic policy checks before coding-agent tool calls execute.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pramagent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
