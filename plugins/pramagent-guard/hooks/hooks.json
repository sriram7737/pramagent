{
  "description": "Pramagent Guard: deterministic policy checks before coding-agent tool calls execute.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|run_shell_command|Write|Edit|MultiEdit|apply_patch|write_file|replace|Read|LS|Grep|Glob|read_file|list_directory|glob|grep_search|search_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pramagent_guard.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command|write_file|replace|read_file|list_directory|glob|grep_search|search_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pramagent_guard.py"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
