{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "scripts/hook_bootstrap.py",
              "--host",
              "pretool",
              "--script",
              "scripts/claude_code_hook.py"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
