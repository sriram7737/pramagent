{
  "hooksConfig": {
    "enabled": true
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "scripts/hook_bootstrap.py",
              "--host",
              "gemini",
              "--script",
              "scripts/gemini_cli_hook.py"
            ],
            "timeout": 20000
          }
        ]
      }
    ]
  }
}
