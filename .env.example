# ─────────────────────────────────────────────────────────────────────────────
# Pramagent environment template
#
# Required values are intentionally EMPTY: docker-compose uses ${VAR:?...}
# interpolation, so an unfilled secret fails the deploy loudly instead of
# booting with a published placeholder. Both services additionally refuse to
# start if a secret matches any known placeholder spelling or is < 16 chars.
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Secret-manager backing (optional): PRAMAGENT_JWT_SECRET, PRAMAGENT_ENCRYPTION_KEY,
# PRAMAGENT_API_KEY, and PRAMAGENT_DASHBOARD_KEY can be sourced from AWS Secrets
# Manager or HashiCorp Vault instead of a plain value here — set
# <NAME>_AWS_SECRET_ID (e.g. PRAMAGENT_JWT_SECRET_AWS_SECRET_ID=arn:aws:...) or
# <NAME>_VAULT_PATH (e.g. PRAMAGENT_JWT_SECRET_VAULT_PATH=secret/data/pramagent/jwt,
# with VAULT_ADDR/VAULT_TOKEN also set) and leave the plain var itself empty.
# See pramagent/secrets.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── required secrets ─────────────────────────────────────────────────────────
# (required, string) Postgres superuser password for the compose stack
POSTGRES_PASSWORD=
# (required, string) password for the non-superuser pramagent_app role the
# API actually connects as (see deploy/postgres/init.sh). Keeping this role
# distinct from the POSTGRES_USER superuser is what makes the
# pramagent_traces row-level-security policy enforce anything — Postgres
# superusers bypass RLS unconditionally.
PRAMAGENT_APP_DB_PASSWORD=
# (required, string) Redis requirepass for the compose stack
REDIS_PASSWORD=
# (required, string) API bearer key mapped to the "default" tenant
PRAMAGENT_API_KEY=
# (optional, csv) tenant:key[:scopes] entries. Scopes are read|write|admin|audit.
# "audit" alone can call /v1/audit/verify without general read access — issue
# it to monitoring/alerting integrations instead of a full read-scoped key.
# Example: default:pramagent_xxx:read|write
PRAMAGENT_API_KEYS=
# (optional, DSN) persistent API-key registry for issue/revoke/audit tooling
PRAMAGENT_API_KEY_DSN=
# (optional, int days) reject API keys older than this — real enforcement,
# not just a documented policy. Unset = no enforcement (default, backward
# compatible). Env-var keys (PRAMAGENT_API_KEYS) track age from process
# start, not true issuance date, since they have no persistent store.
PRAMAGENT_API_KEY_MAX_AGE_DAYS=
# (required, string) audit signing key
PRAMAGENT_SIGNING_KEY=
# (required, string, >=16 chars) HS256 secret for tenant JWTs + dashboard sessions
PRAMAGENT_JWT_SECRET=
# (required, string) shared key for dashboard X-API-Key / fallback login
PRAMAGENT_DASHBOARD_KEY=

# ── persistent store (required: choose exactly one) ──────────────────────────
# The API refuses to start unless one of these three is set (P0-1).
# (option 1, string DSN) compose builds this from POSTGRES_* automatically
#PRAMAGENT_POSTGRES_DSN=postgresql://pramagent:<password>@postgres:5432/pramagent
# (option 2, string path) single-node SQLite persistence
#PRAMAGENT_DB=/data/pramagent.db
# (option 3, dev only) volatile in-memory store, lost on restart
#PRAMAGENT_ALLOW_MEMORY_STORE=1

# ── LLM provider (optional, default: mock) ───────────────────────────────────
# (optional, enum: mock|anthropic|openai|openai-compatible|gemini|ollama|nvidia)
PRAMAGENT_PROVIDER=mock
# (optional, string) required when PRAMAGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# (optional, string) required when PRAMAGENT_PROVIDER=openai
OPENAI_API_KEY=
# (optional, string) required when PRAMAGENT_PROVIDER=gemini
GEMINI_API_KEY=
# (optional, string, default http://localhost:11434) Ollama daemon URL
OLLAMA_HOST=
# (optional, int, default 256) Ollama max generated tokens
OLLAMA_MAX_TOKENS=256
# (optional, float seconds, default 60) Ollama provider timeout
OLLAMA_TIMEOUT_S=60
# (optional, string) NVIDIA NIM key for server-side provider mode only.
# The public /demo page asks users for their own nvapi-* key per request and
# Pramagent never stores it in traces, logs, or persistence.
NVIDIA_API_KEY=
# (optional, string) NVIDIA NIM model for server-side provider mode
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── API service (optional) ───────────────────────────────────────────────────
# (optional, csv of origins, default empty = no CORS) e.g. https://app.example.com
PRAMAGENT_CORS_ORIGINS=
# (optional, url) public base URL of this API — required for Slack HITL callbacks
PRAMAGENT_PUBLIC_URL=
# (optional, string, default info) log level
PRAMAGENT_LOG_LEVEL=info
# (optional, int bytes, default 65536) input size cap enforced by IsolationLayer
PRAMAGENT_MAX_INPUT_BYTES=65536
# (optional, enum: keyword|embedding, default keyword) injection-classifier
# tier. keyword-only is the supported, zero-extra-dependency default;
# embedding requires the pramagent[ml] extra (pulls in torch) and is the
# recommended upgrade for PHI or high-value tool-call deployments.
PRAMAGENT_CLASSIFIER=keyword
# (optional, int, default 100) rate-limit burst capacity per tenant/IP
PRAMAGENT_RATE_LIMIT_CAPACITY=100
# (optional, float tokens/s, default 10) rate-limit refill
PRAMAGENT_RATE_LIMIT_REFILL=10
# (optional, int, default 10) consecutive invalid-credential attempts from
# one peer before a dedicated lockout kicks in, separate from the rate limit
# above (see AuthFailureGuard in pramagent/ratelimit.py)
PRAMAGENT_AUTH_LOCKOUT_THRESHOLD=10
# (optional, int seconds, default 300) failures older than this are forgotten
PRAMAGENT_AUTH_LOCKOUT_WINDOW_S=300
# (optional, float seconds, default 30) lockout duration at the threshold,
# doubling with each further failure up to PRAMAGENT_AUTH_LOCKOUT_MAX_S
PRAMAGENT_AUTH_LOCKOUT_BASE_S=30
# (optional, float seconds, default 900) lockout duration cap
PRAMAGENT_AUTH_LOCKOUT_MAX_S=900
# (optional, redis url) share lockout state across replicas; defaults to
# PRAMAGENT_REDIS_URL if unset, else in-process only
PRAMAGENT_AUTH_LOCKOUT_REDIS_URL=
# (optional, bool, default true) expose public zero-config browser demo.
# Set false for API-only deployments.
PRAMAGENT_DEMO_ENABLED=true
# (optional, bool) required for public unauthenticated API/dev demo mode
PRAMAGENT_ALLOW_UNAUTHENTICATED_API=
# (optional, ISO8601 or unix epoch) time-box the flag above so a demo opt-in
# can't stay silently in effect forever; once past, unauthenticated boot on
# a public-looking runtime is refused again as if the flag were never set
PRAMAGENT_ALLOW_UNAUTHENTICATED_API_UNTIL=
# (optional, bool) redirect http requests to https at the app layer
PRAMAGENT_FORCE_HTTPS=
# (optional, bool) append HSTS preload to Strict-Transport-Security
PRAMAGENT_HSTS_PRELOAD=
# (optional, csv of IPs/CIDRs) only trust X-Forwarded-Proto from these peers.
# Empty = trust no forwarded-proto headers by default. If your PaaS edge proxy
# IPs are not stable/known, set PRAMAGENT_TRUST_UNLISTED_X_FORWARDED_PROTO=1
# deliberately rather than accepting spoofable headers by accident.
PRAMAGENT_TRUSTED_PROXY_IPS=
# (optional, bool) explicit PaaS compatibility escape hatch for the setting
# above; only use when the app is not directly reachable except through the
# managed edge proxy.
PRAMAGENT_TRUST_UNLISTED_X_FORWARDED_PROTO=
# (optional, int per IP+hashed provider key per hour, default 60) public demo throttle
PRAMAGENT_DEMO_RATE_LIMIT=60
# (optional) enables protected product-signal admin view at /demo/admin/signals
PRAMAGENT_DEMO_ADMIN_KEY=
# (optional) persist opt-in demo usage and managed-pilot hashes to Postgres
PRAMAGENT_DEMO_SIGNALS_POSTGRES_DSN=
# (optional) stable salt for visitor/contact hashes across restarts; keep secret
PRAMAGENT_DEMO_SIGNAL_SALT=

# ── per-tenant usage quotas (optional, empty = unlimited) ────────────────────
# (optional, int) max calls per window
PRAMAGENT_QUOTA_CALLS=
# (optional, int) max tool validations per window
PRAMAGENT_QUOTA_TOOL_VALIDATIONS=
# (optional, float USD) max provider spend per window
PRAMAGENT_QUOTA_COST_USD=
# (optional, int seconds, default 86400) quota window
PRAMAGENT_QUOTA_WINDOW_S=86400

# ── usage analytics / billing hook (optional, fail-open) ─────────────────────
# (optional, https url) billing webhook sink
PRAMAGENT_BILLING_WEBHOOK_URL=
# (optional, string) shared-secret header for the billing webhook
PRAMAGENT_BILLING_WEBHOOK_SECRET=
# (optional, float seconds, default 2.0) billing webhook timeout
PRAMAGENT_BILLING_WEBHOOK_TIMEOUT_S=2.0

# ── HITL Slack integration (optional; all four required to enable) ───────────
# (optional, string) Slack bot token (xoxb-…)
SLACK_BOT_TOKEN=
# (optional, string) Slack channel for approval messages
SLACK_CHANNEL_ID=
# (optional, string) Slack signing secret for callback verification
SLACK_SIGNING_SECRET=
# legacy aliases still honored by compose
PRAMAGENT_HITL_SLACK_TOKEN=
PRAMAGENT_HITL_SLACK_CHANNEL=

# ── encryption at rest (optional) ────────────────────────────────────────────
# (optional, Fernet key) enables EncryptedSQLiteStore when PRAMAGENT_DB is
# set, or column-level encryption of the payload column (BYTEA, not JSONB)
# when PRAMAGENT_POSTGRES_DSN is set. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRAMAGENT_ENCRYPTION_KEY=
# (optional, bool) require encrypted/attested at-rest storage
PRAMAGENT_REQUIRE_ENCRYPTED_STORE=
# (optional, bool) enables fail-closed PHI posture: auth + encrypted store required
PRAMAGENT_PHI_MODE=
# (optional, bool) alternative to PRAMAGENT_ENCRYPTION_KEY for satisfying PHI/
# encrypted-store mode on Postgres: attest managed disk/TDE encryption instead
# of application-level column encryption
PRAMAGENT_POSTGRES_ENCRYPTION_AT_REST=
# (optional, Fernet key) S3 cold-archive encryption key
PRAMAGENT_ARCHIVE_KEY=

# ── Postgres backup (opt-in: docker compose --profile backup up) ────────────
# (required for the backup profile) destination bucket for scheduled pg_dump
PRAMAGENT_BACKUP_S3_BUCKET=
# (optional, default pramagent/backups) key prefix within the bucket
PRAMAGENT_BACKUP_S3_PREFIX=pramagent/backups
# (optional, default 30) delete backups older than this many days
PRAMAGENT_BACKUP_RETENTION_DAYS=30
# (optional) KMS key ID for SSE-KMS; omit to use SSE-S3 (AES256)
PRAMAGENT_BACKUP_KMS_KEY_ID=
# (optional, default 3600) seconds between scheduled backup runs
PRAMAGENT_BACKUP_INTERVAL_S=3600
# (required for the backup profile, unless using an IAM instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# (required to run deploy/postgres/restore_verify.py) scratch DB DSN — never
# point this at production; pg_restore --clean drops the target schema first
PRAMAGENT_RESTORE_VERIFY_DSN=

# ── automated audit-chain tamper detection (opt-in: docker compose --profile audit-watch up) ──
# (optional, https url) alert sink for `pramagent audit-verify-watch`; posts
# a JSON body with broken_link_count/broken_links on tamper detection
PRAMAGENT_AUDIT_ALERT_WEBHOOK_URL=
# (optional, string) shared-secret header for the audit alert webhook
PRAMAGENT_AUDIT_ALERT_WEBHOOK_SECRET=
# (optional, default 5.0) audit alert webhook timeout in seconds
PRAMAGENT_AUDIT_ALERT_TIMEOUT_S=5.0
# (optional, default 900) seconds between chain-verify checks in the
# audit-watch profile service
PRAMAGENT_AUDIT_WATCH_INTERVAL_S=900

# ── scheduled retention pruning (opt-in: docker compose --profile retention-prune up) ──
# (required for the retention-prune profile) tenant to prune — one instance
# per tenant; retention-prune refuses to run unscoped
PRAMAGENT_RETENTION_TENANT_ID=
# (optional, default 365, floor 180) retention window in days
PRAMAGENT_RETENTION_DAYS=365
# (optional, default 86400) seconds between prune runs
PRAMAGENT_RETENTION_INTERVAL_S=86400

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
# (optional, OTLP gRPC endpoint) e.g. http://otel-collector:4317
PRAMAGENT_OTEL_ENDPOINT=

# ── dashboard (optional) ─────────────────────────────────────────────────────
# (optional, string, default default) tenant scope for dashboard sessions
PRAMAGENT_DASHBOARD_TENANT=default
# (optional, bool, default false) required before tenant "*" is honored
PRAMAGENT_DASHBOARD_ALLOW_SUPER_ADMIN=false
# (optional, bool, default false) let the LOGIN FORM accept
# PRAMAGENT_DASHBOARD_KEY as a password for any username — a de facto shared
# backdoor (one session per login attempt, not tied to a real account).
# The separate X-API-Key header path (CLI/curl) is unaffected by this flag.
# Single-team alpha pilots only; configure a real dashboard user store otherwise.
PRAMAGENT_DASHBOARD_ALLOW_SHARED_KEY_LOGIN=false
# (optional, bool, default true) cookies require HTTPS; set false only for
# plain-http local dev that isn't on localhost (browsers already treat
# http://localhost as a trustworthy origin for Secure cookies)
PRAMAGENT_DASHBOARD_SECURE_COOKIE=true
# (optional, redis url) dashboard rate-limit/session-revocation backend
PRAMAGENT_DASHBOARD_REDIS_URL=

# ── local ports / compose project (optional) ─────────────────────────────────
COMPOSE_PROJECT_NAME=pramagent
POSTGRES_USER=pramagent
POSTGRES_DB=pramagent
API_PORT=8080
DASHBOARD_PORT=8501
